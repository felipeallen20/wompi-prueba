// Prisma schema for the checkout platform backend.
// The schema mirrors the domain model defined under src/domain.
// Amounts are stored as integer minor units (COP/centavos), never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
}

enum DeliveryStatus {
  PENDING
  SHIPPED
  DELIVERED
}

model Customer {
  id       String   @id @default(uuid())
  fullName String
  email    String   @unique
  phone    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  deliveries   Delivery[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String
  price       Int
  imageUrl    String

  stock        Stock?
  transactions Transaction[]
}

model Stock {
  productId         String @id
  quantityAvailable Int    @default(0)
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Delivery {
  id         String        @id @default(uuid())
  customerId String
  address    String
  city       String
  status     DeliveryStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  transactions Transaction[]

  @@index([customerId])
}

model Transaction {
  id               String            @id @default(uuid())
  productId        String
  customerId       String
  deliveryId       String?
  status           TransactionStatus @default(PENDING)
  amount           Int
  baseFee          Int
  deliveryFee      Int
  gatewayReference String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  delivery Delivery? @relation(fields: [deliveryId], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([deliveryId])
}
